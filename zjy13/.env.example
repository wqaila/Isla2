# ===== 云端 LLM 配置示例 =====
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 本文件必须是 UTF-8（无 BOM）编码。

# 适配器类型。当前仅实现 openai_compat（OpenAI /chat/completions 协议）。
LLM_PROVIDER=openai_compat

# 服务商 API 根地址（不带 /chat/completions）
# 已实测可用：https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 实测推荐：deepseek-flash（首字 P95 约 1s，优于 deepseek-v4-pro）
LLM_MODEL=deepseek-flash

# 接口路径，默认 /chat/completions（会拼在 LLM_BASE_URL 之后）
LLM_CHAT_PATH=/chat/completions

# 超时（秒）：连接 / 单次读取 / 整轮总上限
LLM_CONNECT_TIMEOUT_S=10
LLM_REQUEST_TIMEOUT_S=20
LLM_TOTAL_TIMEOUT_S=45

# 重试：最大尝试次数（含首次）与指数退避参数
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_S=0.5
LLM_BACKOFF_MAX_S=4

# 采样参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256

# 是否使用流式输出；是否在流式末尾请求 usage 统计
# 注意：部分服务商不支持 stream_options，默认关闭。
LLM_STREAM=true
LLM_STREAM_INCLUDE_USAGE=false

# 推理模型思考开关：default（不发送）/ disabled / enabled
# DeepSeek V4 系列默认开启思考，会显著增加首字延迟；语音交互建议 disabled。
LLM_THINKING=disabled

# ===== 角色卡 =====
CHARACTERS_DIR=server/characters
DEFAULT_CHARACTER_ID=default

# HTTP 代理（默认直连；直连不通时填写，例如 http://127.0.0.1:7897）
# 注意：仅对 LLM 请求生效，TTS 走本地回环不需要代理。
LLM_PROXY=
