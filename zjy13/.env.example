# ===== 云端 LLM 配置示例 =====
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 本文件必须是 UTF-8（无 BOM）编码。

# 适配器类型。当前仅实现 openai_compat（OpenAI /chat/completions 协议）。
LLM_PROVIDER=openai_compat

# 服务商 API 根地址（不带 /chat/completions）
# 已实测可用：https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 实测推荐：deepseek-flash（首字 P95 约 1s，优于 deepseek-v4-pro）
LLM_MODEL=deepseek-flash

# 接口路径，默认 /chat/completions（会拼在 LLM_BASE_URL 之后）
LLM_CHAT_PATH=/chat/completions

# 超时（秒）：连接 / 单次读取 / 整轮总上限
LLM_CONNECT_TIMEOUT_S=10
LLM_REQUEST_TIMEOUT_S=20
LLM_TOTAL_TIMEOUT_S=45

# 重试：最大尝试次数（含首次）与指数退避参数
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_S=0.5
LLM_BACKOFF_MAX_S=4

# 采样参数
LLM_TEMPERATURE=0.7
# 128 token ≈ 85 汉字（约 3 句）。原为 256（约 170 汉字），实测会偶发长回复，
# 合成出 16 秒以上的长音频，在移动热点/WiFi Direct 链路上容易把下行推爆
# （transport 写超时断连）。语音场景用 128 更稳，体验也更自然。
LLM_MAX_TOKENS=128

# 是否使用流式输出；是否在流式末尾请求 usage 统计
# 注意：部分服务商不支持 stream_options，默认关闭。
LLM_STREAM=true
LLM_STREAM_INCLUDE_USAGE=false

# 推理模型思考开关：default（不发送）/ disabled / enabled
# DeepSeek V4 系列默认开启思考，会显著增加首字延迟；语音交互建议 disabled。
LLM_THINKING=disabled

# ===== 角色卡 =====
CHARACTERS_DIR=server/characters
# 当前默认角色：爱莉希雅（elysia）。保留 default.yaml（小满）可随时切回。
DEFAULT_CHARACTER_ID=elysia

# HTTP 代理（默认直连；直连不通时填写，例如 http://127.0.0.1:7897）
# 注意：仅对 LLM 请求生效，TTS 走本地回环不需要代理。
LLM_PROXY=

# ===== 本地 TTS（CosyVoice3，跑在 WSL2）=====
# 服务只监听回环地址，Windows 侧通过 HTTP 调用。
TTS_BASE_URL=http://127.0.0.1:50000
TTS_SYNTH_PATH=/synthesize
TTS_HEALTH_PATH=/health
# 单次合成超时（秒）。实测合成耗时 3~6 秒，120 秒足够覆盖长句与冷启动。
TTS_TIMEOUT_S=120
TTS_CONNECT_TIMEOUT_S=5
# 合成结果落盘目录（已被 .gitignore 忽略）
TTS_OUTPUT_DIR=logs/tts
# 默认音色。角色卡里的 tts_voice_id 优先级更高，这里是兜底值。
TTS_VOICE_ID=elysia
