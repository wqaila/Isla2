# 复制为 .env 后编辑；此文件只包含配置示例。
# 默认关闭真实模型调用。确认服务商、模型和费用后改成 true。
GATEWAY_CLOUD_ENABLED=false
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8111
# 留空时自动生成设备令牌，保存在 .local/device_token。
GATEWAY_DEVICE_TOKEN=
GATEWAY_RATE_LIMIT=20
# 填写服务商的 OpenAI 兼容地址，必须使用 HTTPS。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=45
# 默认不继承系统代理；需要代理访问所选服务商时显式开启。
LLM_TRUST_ENV=false
