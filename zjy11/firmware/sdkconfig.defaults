# 板级默认配置：ESP32-S3-Touch-LCD-1.85B
#
# 这些值必须与硬件一致，否则会出现「能用但浪费一半 Flash」
# 或「PSRAM 申请失败」这类难排查问题。
# 依据：官方规格 16MB Flash + 8MB PSRAM（ESP32-S3R8）。

# 固件目标
CONFIG_IDF_TARGET="esp32s3"

# 16MB Flash（默认是 2MB，必须改）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8MB PSRAM（ESP32-S3R8 为八线 PSRAM）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# 中断看门狗：第一版串口读阻塞时间较长，放宽避免误复位
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 控制台输出走 USB Serial/JTAG（Type-C 直连，无需额外接线）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 中文字体：LVGL 9 内置思源黑体简体，启用 16px 用于正文
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK=y

# 分区表：中文字库让固件超过 1MB，用 16MB Flash 的单应用大分区
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 诊断用：英文对比字体
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
