# ===== 数据与产物：一律不入库 =====
#
# 原因有两条：
#   1. 体积 —— 模型权重动辄几 GB，参考音频和数据集也会快速增长
#   2. 权益 —— 参考音频如果来自动漫角色，实际是配音演员的声音，
#              不适合随公开仓库分发（详见 声音生成.md 第四十七节）
#
# 仓库里只放代码和文档，数据留在本地。

# 模型权重
models/

# 数据集（原始 / 分离 / 清洗 / 切片 / 标注）
dataset/

# 生成的音频与生成历史
outputs/
history/

# 角色资料（参考音频、情绪参考、微调模型、配置）
characters/

# 本地配置
configs/

# ===== Python 环境 =====
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# ===== 临时与备份 =====
*.bak
*.bak-*
*.tmp
*.log
